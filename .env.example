# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file to version control.

SAP_COMPANY_CODE=XXXX
SAP_BANK_ACCOUNT=00000000
SAP_MOVEMENT_CLASS=XX
DATA_CUTOFF_HOUR=10
HOLIDAY_COUNTRY=US

EXPORT_FOLDER=C:\temp\sap_exports

SAP_FAVORITE_NODE=F00001
SAP_LAYOUT_VARIANT=/DEFAULT

EXCEL_WORKBOOK_URL_TEMPLATE=https://YOUR_TENANT.sharepoint.com/personal/YOUR_USER/Documents/Reports/{year}/{month_folder}/Workbook_{month_name}_{year}.xlsx
EXCEL_TABLE_NAME=BankMovements
